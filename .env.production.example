APP_ENV=production
PUBLIC_SITE_URL=https://www.example.com
PUBLIC_API_URL=https://www.example.com
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=perfurm
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PAYMENT_RESERVATION_MINUTES=20
ACCOUNT_DELETION_GRACE_DAYS=30
ORDER_PII_RETENTION_DAYS=2555
CORS_ORIGINS=https://www.example.com
USE_MOCK_DB=false
ENABLE_DEMO_OTP=false
OPERATING_SELLER_ID=
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
METRICS_TOKEN=GENERATE_A_SEPARATE_MONITORING_SECRET
TAX_PRICES_INCLUDE_GST=true
TAX_ORIGIN_STATE=Maharashtra
BUSINESS_LEGAL_NAME=Perfurm Commerce
BUSINESS_GSTIN=
BUSINESS_ADDRESS=
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPPING_PROVIDER_API_URL=
SHIPPING_PROVIDER_API_TOKEN=
SHIPPING_PROVIDER_WEBHOOK_SECRET=
# Coordinates are substituted by the API. Replace the whole URL to change provider.
REVERSE_GEOCODING_URL=https://api.bigdatacloud.net/data/reverse-geocode-client?latitude={latitude}&longitude={longitude}&localityLanguage=en
REACT_APP_BACKEND_URL=

# GO-LIVE NOTES
# 1. Store this file's VALUES in your host/secret manager; never commit a real .env.
# 2. PUBLIC_SITE_URL/PUBLIC_API_URL/CORS_ORIGINS must be your final HTTPS domains.
# 3. MongoDB must be authenticated, backed up and use a replicaSet connection string.
# 4. Create Razorpay live keys and register PUBLIC_API_URL/api/payments/webhook.
# 5. Register PUBLIC_API_URL/api/shipping/webhook with the carrier and use a unique secret.
# 6. Verify the SMTP sending domain and/or SMS adapter before enabling notifications.
# 7. Keep both coordinate placeholders in REVERSE_GEOCODING_URL.
# 8. Keep REACT_APP_BACKEND_URL blank with the included same-origin Nginx /api proxy.
# 9. Run: python backend/scripts/validate_release_env.py .env --require-commerce-providers
# 10. Restart/redeploy after changing backend environment values, then check /health and /ready.
