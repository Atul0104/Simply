APP_ENV=staging
PUBLIC_SITE_URL=https://staging.example.com
PUBLIC_API_URL=https://staging.example.com
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=perfurm_staging
WEB_CONCURRENCY=2
UVICORN_LIMIT_CONCURRENCY=512
UVICORN_BACKLOG=2048
MAX_INFLIGHT_REQUESTS=200
REQUEST_QUEUE_TIMEOUT_MS=250
PUBLIC_CACHE_TTL_SECONDS=15
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_WAIT_QUEUE_TIMEOUT_MS=2000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
RUN_BACKGROUND_WORKERS=false
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=perfurm_refresh
CSRF_COOKIE_NAME=perfurm_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CONSENT_POLICY_VERSION=2026-08-06.1
COOKIE_POLICY_VERSION=2026-08-06.1
PRIVACY_POLICY_VERSION=2026-08-06.1
CONSENT_EXPIRY_DAYS=180
GPC_SUPPORT=true
PAYMENT_RESERVATION_MINUTES=20
ACCOUNT_DELETION_GRACE_DAYS=30
ORDER_PII_RETENTION_DAYS=2555
CORS_ORIGINS=https://staging.example.com
USE_MOCK_DB=false
ENABLE_DEMO_OTP=false
OPERATING_SELLER_ID=
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
METRICS_TOKEN=GENERATE_A_SEPARATE_MONITORING_SECRET
TAX_PRICES_INCLUDE_GST=true
TAX_ORIGIN_STATE=Maharashtra
BUSINESS_LEGAL_NAME=Perfurm Commerce
BUSINESS_GSTIN=
BUSINESS_ADDRESS=
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPPING_PROVIDER_API_URL=
SHIPPING_PROVIDER_API_TOKEN=
SHIPPING_PROVIDER_WEBHOOK_SECRET=
# Coordinates are substituted by the API. Replace the whole URL to change provider.
REVERSE_GEOCODING_URL=https://api.bigdatacloud.net/data/reverse-geocode-client?latitude={latitude}&longitude={longitude}&localityLanguage=en
REACT_APP_BACKEND_URL=

# STAGING NOTES
# Use isolated test provider accounts, an isolated MongoDB replica-set database and HTTPS.
# Register payment/shipping callbacks under PUBLIC_API_URL, run validate_release_env.py,
# qualify transactions, then execute API and browser acceptance suites before promotion.
