# Runtime: development | test | staging | production
APP_ENV=development
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Backend
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=perfurm
# API capacity, database pooling and safe public-read caching.
WEB_CONCURRENCY=2
UVICORN_LIMIT_CONCURRENCY=512
UVICORN_BACKLOG=2048
MAX_INFLIGHT_REQUESTS=200
REQUEST_QUEUE_TIMEOUT_MS=250
PUBLIC_CACHE_TTL_SECONDS=15
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_WAIT_QUEUE_TIMEOUT_MS=2000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
RUN_BACKGROUND_WORKERS=true
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie/session security and versioned consent. COOKIE_SECURE must be true in staging/production.
REFRESH_COOKIE_NAME=perfurm_refresh
CSRF_COOKIE_NAME=perfurm_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CONSENT_POLICY_VERSION=2026-08-06.1
COOKIE_POLICY_VERSION=2026-08-06.1
PRIVACY_POLICY_VERSION=2026-08-06.1
CONSENT_EXPIRY_DAYS=180
GPC_SUPPORT=true
PAYMENT_RESERVATION_MINUTES=20
# Tax and invoice identity. Prices include GST by default; set false only when
# catalogue prices are stored before tax. Production sellers must have GSTINs.
TAX_PRICES_INCLUDE_GST=true
TAX_ORIGIN_STATE=Maharashtra
BUSINESS_LEGAL_NAME=Perfurm Marketplace
BUSINESS_GSTIN=
BUSINESS_ADDRESS=
OPERATING_SELLER_ID=
# Privacy deletion grace and retained order/invoice PII policy (default 7 years).
ACCOUNT_DELETION_GRACE_DAYS=30
ORDER_PII_RETENTION_DAYS=2555
METRICS_TOKEN=replace-with-a-separate-random-monitoring-token

# Durable external notification outbox. In-app notifications work when disabled.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=http://localhost:3000
USE_MOCK_DB=false
ENABLE_DEMO_OTP=false

# Payments (leave unset only when online payments are intentionally disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Carrier label API. The endpoint receives order/items/address/parcel JSON and
# must return tracking_id (or awb), with optional barcode, id and label_url.
SHIPPING_PROVIDER_API_URL=
SHIPPING_PROVIDER_API_TOKEN=
SHIPPING_PROVIDER_WEBHOOK_SECRET=

# Planned provider adapters. These are server-only unless explicitly marked REACT_APP_*.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Perfurm
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TURNSTILE_SECRET_KEY=
GA_MEASUREMENT_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
BETTERSTACK_SOURCE_TOKEN=
MSG91_AUTH_KEY=

# Frontend build-time API origin. Leave blank for the recommended same-origin
# Nginx /api proxy; set an HTTPS origin only when the API is deployed separately.
REACT_APP_BACKEND_URL=
REACT_APP_CSRF_COOKIE_NAME=perfurm_csrf
REACT_APP_TURNSTILE_SITE_KEY=
# Use {latitude} and {longitude} placeholders to switch reverse-geocoding providers globally.
REVERSE_GEOCODING_URL=https://api.bigdatacloud.net/data/reverse-geocode-client?latitude={latitude}&longitude={longitude}&localityLanguage=en
